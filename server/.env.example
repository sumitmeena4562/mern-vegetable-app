# 🔒 AgriConnect Server Environment Variables

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development  # Options: development, production, staging

# ============================================
# DATABASE
# ============================================
# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/agriconnect

# MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/agriconnect

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# JWT Secret - MUST be a strong, random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=30d

# ⚠️ SECURITY: Change these for production!
# CORS Allowed Origins (comma-separated)
# FRONTEND_URL=https://yourdomain.com,https://app.yourdomain.com
FRONTEND_URL=http://localhost:5173

# ============================================
# CLOUDINARY (Image Storage)
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# EMAIL SERVICE (Nodemailer)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@agriconnect.com

# ============================================
# SMS SERVICE (Twilio)
# ============================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# PAYMENT GATEWAY (Razorpay)
# ============================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ============================================
# 🔒 SECURITY NOTES
# ============================================
# 1. NEVER commit the actual .env file to git
# 2. Use strong, randomly generated JWT_SECRET
# 3. Set NODE_ENV=production in production
# 4. Update FRONTEND_URL with your actual domain
# 5. Enable HTTPS in production
# 6. Regularly rotate sensitive credentials
# 7. Use environment-specific .env files:
#    - .env.development
#    - .env.staging
#    - .env.production
